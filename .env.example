NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Production canonical LMS URL.
# On Vercel, set this to https://learn.charanorganics.com after the domain is connected.
# While testing a Vercel preview link, set it to that exact https://your-project.vercel.app URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bunny.net Stream (video hosting for paid lessons)
BUNNY_STREAM_API_KEY=your-bunny-stream-api-key-here
NEXT_PUBLIC_BUNNY_LIBRARY_ID=your-library-id-here
NEXT_PUBLIC_BUNNY_CDN_HOSTNAME=vz-xxxxxxxx.b-cdn.net
